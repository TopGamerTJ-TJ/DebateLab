{
  "name": "ForumComment",
  "type": "object",
  "properties": {
    "postId": {
      "type": "string",
      "maxLength": 4000000
    },
    "parentCommentId": {
      "type": "string",
      "maxLength": 4000000
    },
    "content": {
      "type": "string",
      "maxLength": 4000000
    },
    "authorName": {
      "type": "string",
      "maxLength": 4000000
    },
    "upvotes": {
      "type": "number",
      "default": 0
    },
    "downvotes": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "postId",
    "content"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}