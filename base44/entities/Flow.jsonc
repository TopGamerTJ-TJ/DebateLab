{
  "name": "Flow",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 4000000
    },
    "format": {
      "type": "string",
      "maxLength": 4000000
    },
    "resolution": {
      "type": "string",
      "maxLength": 4000000
    },
    "columns": {
      "type": "object"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4000000
      }
    },
    "tournamentId": {
      "type": "string",
      "maxLength": 4000000
    },
    "notes": {
      "type": "string",
      "maxLength": 4000000
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}