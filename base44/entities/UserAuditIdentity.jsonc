{
  "name": "UserAuditIdentity",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string"
    },
    "auditId": {
      "type": "number"
    }
  },
  "required": [
    "userId",
    "auditId"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}