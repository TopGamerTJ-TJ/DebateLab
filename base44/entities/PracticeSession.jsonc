{
  "name": "PracticeSession",
  "type": "object",
  "properties": {
    "ownerUserId": {
      "type": "string"
    },
    "auditId": {
      "type": "number"
    },
    "format": {
      "type": "string"
    },
    "side": {
      "type": "string"
    },
    "resolution": {
      "type": "string"
    },
    "difficulty": {
      "type": "string"
    },
    "transcript": {
      "type": "string"
    },
    "rfd": {
      "type": "string"
    },
    "winner": {
      "type": "string"
    },
    "speakerPoints": {
      "type": "number"
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "weaknesses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "keyVotingIssues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "duration": {
      "type": "number"
    }
  },
  "required": [
    "format",
    "side"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.ownerUserId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.ownerUserId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.ownerUserId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}