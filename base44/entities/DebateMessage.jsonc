{
  "name": "DebateMessage",
  "type": "object",
  "properties": {
    "matchId": {
      "type": "string",
      "maxLength": 4000000
    },
    "senderId": {
      "type": "string",
      "maxLength": 4000000
    },
    "senderName": {
      "type": "string",
      "maxLength": 4000000
    },
    "role": {
      "type": "string",
      "enum": [
        "pro",
        "con",
        "system",
        "spectator"
      ],
      "maxLength": 4000000
    },
    "type": {
      "type": "string",
      "enum": [
        "opening",
        "rebuttal",
        "counter",
        "closing",
        "normal",
        "system"
      ],
      "default": "normal",
      "maxLength": 4000000
    },
    "content": {
      "type": "string",
      "maxLength": 4000000
    }
  },
  "required": [
    "matchId",
    "senderId",
    "role",
    "content"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}