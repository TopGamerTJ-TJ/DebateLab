{
  "name": "Tournament",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 4000000
    },
    "format": {
      "type": "string",
      "enum": [
        "parliamentary",
        "public_forum",
        "model_un",
        "model_congress"
      ],
      "maxLength": 4000000
    },
    "location": {
      "type": "string",
      "maxLength": 4000000
    },
    "date": {
      "type": "string",
      "maxLength": 4000000
    },
    "division": {
      "type": "string",
      "maxLength": 4000000
    },
    "rounds": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "wins": {
      "type": "number"
    },
    "losses": {
      "type": "number"
    },
    "speakerPoints": {
      "type": "number"
    },
    "notes": {
      "type": "string",
      "maxLength": 4000000
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "active",
        "completed"
      ],
      "maxLength": 4000000
    },
    "caseIds": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4000000
      }
    }
  },
  "required": [
    "name",
    "format"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}