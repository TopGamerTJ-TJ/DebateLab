{
  "name": "Tournament",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "format": {
      "type": "string",
      "enum": [
        "parliamentary",
        "public_forum",
        "model_un",
        "model_congress"
      ]
    },
    "location": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "division": {
      "type": "string"
    },
    "rounds": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "wins": {
      "type": "number"
    },
    "losses": {
      "type": "number"
    },
    "speakerPoints": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "active",
        "completed"
      ]
    },
    "caseIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "name",
    "format"
  ]
}