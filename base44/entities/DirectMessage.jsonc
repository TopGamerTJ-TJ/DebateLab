{
  "name": "DirectMessage",
  "type": "object",
  "properties": {
    "ownerUserId": {
      "type": "string",
      "maxLength": 4000000
    },
    "auditId": {
      "type": "number"
    },
    "senderId": {
      "type": "string",
      "maxLength": 4000000
    },
    "receiverId": {
      "type": "string",
      "maxLength": 4000000
    },
    "content": {
      "type": "string",
      "maxLength": 4000000
    }
  },
  "required": [
    "senderId",
    "receiverId",
    "content"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.senderId": "{{user.id}}"
        },
        {
          "data.receiverId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.senderId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.senderId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    }
  }
}