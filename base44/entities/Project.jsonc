{
  "name": "Project",
  "type": "object",
  "properties": {
    "ownerUserId": {
      "type": "string"
    },
    "auditId": {
      "type": "number"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "format": {
      "type": "string",
      "enum": [
        "parliamentary",
        "public_forum",
        "model_un",
        "model_congress"
      ]
    },
    "resolution": {
      "type": "string"
    },
    "side": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "isArchived": {
      "type": "boolean"
    },
    "aiMode": {
      "type": "string",
      "enum": [
        "default",
        "full",
        "dampened"
      ],
      "default": "default"
    },
    "folderId": {
      "type": "string"
    },
    "conferenceProfileId": {
      "type": "string"
    },
    "whitelist": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "blacklist": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "strictMode": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.ownerUserId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.ownerUserId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.ownerUserId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}