{
  "name": "DebateMatch",
  "type": "object",
  "properties": {
    "ownerUserId": {
      "type": "string",
      "maxLength": 4000000
    },
    "auditId": {
      "type": "number"
    },
    "lobbyId": {
      "type": "string",
      "maxLength": 4000000
    },
    "topic": {
      "type": "string",
      "maxLength": 4000000
    },
    "format": {
      "type": "string",
      "maxLength": 4000000
    },
    "proPlayerId": {
      "type": "string",
      "maxLength": 4000000
    },
    "proPlayerName": {
      "type": "string",
      "maxLength": 4000000
    },
    "conPlayerId": {
      "type": "string",
      "maxLength": 4000000
    },
    "conPlayerName": {
      "type": "string",
      "maxLength": 4000000
    },
    "status": {
      "type": "string",
      "enum": [
        "prep",
        "live",
        "ended"
      ],
      "default": "prep",
      "maxLength": 4000000
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 4000000
    },
    "prepTimeSeconds": {
      "type": "number"
    },
    "timePerSideSeconds": {
      "type": "number"
    },
    "currentTurn": {
      "type": "string",
      "enum": [
        "pro",
        "con",
        "open"
      ],
      "default": "open",
      "maxLength": 4000000
    },
    "winnerId": {
      "type": "string",
      "maxLength": 4000000
    },
    "aiEvaluation": {
      "type": "string",
      "maxLength": 4000000
    },
    "proScore": {
      "type": "number"
    },
    "conScore": {
      "type": "number"
    },
    "isRanked": {
      "type": "boolean",
      "default": false
    },
    "spectatorIds": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4000000
      }
    }
  },
  "required": [
    "lobbyId",
    "topic",
    "proPlayerId",
    "conPlayerId"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {
      "$or": [
        {
          "data.proPlayerId": "{{user.id}}"
        },
        {
          "data.conPlayerId": "{{user.id}}"
        },
        {
          "data.ownerUserId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}