{
  "name": "ConferenceProfile",
  "type": "object",
  "properties": {
    "ownerUserId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "conferenceType": {
      "type": "string",
      "enum": [
        "model_congress",
        "model_un",
        "debate",
        "other"
      ],
      "default": "model_congress"
    },
    "notes": {
      "type": "string"
    },
    "procedureText": {
      "type": "string"
    },
    "procedureFileUrl": {
      "type": "string"
    },
    "procedureFileName": {
      "type": "string"
    },
    "billTemplateText": {
      "type": "string"
    },
    "billTemplateFileUrl": {
      "type": "string"
    },
    "billTemplateFileName": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.ownerUserId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.ownerUserId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.ownerUserId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}