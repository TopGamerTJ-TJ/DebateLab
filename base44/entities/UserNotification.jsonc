{
  "name": "UserNotification",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "maxLength": 4000000
    },
    "title": {
      "type": "string",
      "maxLength": 4000000
    },
    "message": {
      "type": "string",
      "maxLength": 4000000
    },
    "link": {
      "type": "string",
      "maxLength": 4000000
    },
    "isRead": {
      "type": "boolean",
      "default": false
    },
    "type": {
      "type": "string",
      "maxLength": 4000000
    }
  },
  "required": [
    "userId",
    "title",
    "message"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}