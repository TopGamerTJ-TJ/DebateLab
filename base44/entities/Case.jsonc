{
  "name": "Case",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 4000000
    },
    "format": {
      "type": "string",
      "enum": [
        "parliamentary",
        "public_forum",
        "model_un",
        "model_congress"
      ],
      "maxLength": 4000000
    },
    "resolution": {
      "type": "string",
      "maxLength": 4000000
    },
    "side": {
      "type": "string",
      "maxLength": 4000000
    },
    "description": {
      "type": "string",
      "maxLength": 4000000
    },
    "contentionIds": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4000000
      }
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4000000
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4000000
      }
    },
    "isFavorite": {
      "type": "boolean"
    },
    "tournamentId": {
      "type": "string",
      "maxLength": 4000000
    },
    "version": {
      "type": "number"
    },
    "notes": {
      "type": "string",
      "maxLength": 4000000
    }
  },
  "required": [
    "title",
    "format"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}