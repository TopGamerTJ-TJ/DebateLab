{
  "name": "OtherDocument",
  "type": "object",
  "properties": {
    "ownerUserId": {
      "type": "string",
      "maxLength": 4000000
    },
    "title": {
      "type": "string",
      "maxLength": 4000000
    },
    "docLabel": {
      "type": "string",
      "description": "Free-form label for the document type, e.g. 'Cross-Ex Prep', 'Briefing Memo'",
      "maxLength": 4000000
    },
    "description": {
      "type": "string",
      "description": "The instructions the user gave the AI for what to generate",
      "maxLength": 4000000
    },
    "content": {
      "type": "string",
      "maxLength": 4000000
    },
    "takeaways": {
      "type": "string",
      "maxLength": 4000000
    },
    "importantNotes": {
      "type": "string",
      "maxLength": 4000000
    },
    "sources": {
      "type": "string",
      "maxLength": 4000000
    },
    "projectId": {
      "type": "string",
      "maxLength": 4000000
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4000000
      }
    },
    "isFavorite": {
      "type": "boolean"
    }
  },
  "required": [
    "title",
    "content"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.ownerUserId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.ownerUserId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.ownerUserId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}