{
  "name": "Contention",
  "type": "object",
  "properties": {
    "ownerUserId": {
      "type": "string",
      "maxLength": 4000000
    },
    "auditId": {
      "type": "number"
    },
    "title": {
      "type": "string",
      "maxLength": 4000000
    },
    "format": {
      "type": "string",
      "enum": [
        "parliamentary",
        "public_forum"
      ],
      "maxLength": 4000000
    },
    "resolution": {
      "type": "string",
      "maxLength": 4000000
    },
    "side": {
      "type": "string",
      "maxLength": 4000000
    },
    "claim": {
      "type": "string",
      "maxLength": 4000000
    },
    "warrant": {
      "type": "string",
      "maxLength": 4000000
    },
    "impact": {
      "type": "string",
      "maxLength": 4000000
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 4000000
          },
          "source": {
            "type": "string",
            "maxLength": 4000000
          },
          "sourceUrl": {
            "type": "string",
            "maxLength": 4000000
          }
        },
        "required": []
      }
    },
    "possibleRebuttals": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4000000
      }
    },
    "rebuttalResponses": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4000000
      }
    },
    "crossfireQuestions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4000000
      }
    },
    "crossfireAnswers": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4000000
      }
    },
    "weighingMechanisms": {
      "type": "object"
    },
    "strategicNotes": {
      "type": "string",
      "maxLength": 4000000
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4000000
      }
    },
    "isFavorite": {
      "type": "boolean"
    },
    "tournamentId": {
      "type": "string",
      "maxLength": 4000000
    },
    "caseId": {
      "type": "string",
      "maxLength": 4000000
    },
    "projectId": {
      "type": "string",
      "maxLength": 4000000
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced",
        "expert"
      ],
      "maxLength": 4000000
    }
  },
  "required": [
    "title",
    "format",
    "resolution",
    "side"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.ownerUserId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.ownerUserId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.ownerUserId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}