{
  "name": "ProjectActivity",
  "type": "object",
  "properties": {
    "ownerUserId": {
      "type": "string",
      "maxLength": 4000000
    },
    "auditId": {
      "type": "number"
    },
    "projectId": {
      "type": "string",
      "maxLength": 4000000
    },
    "userId": {
      "type": "string",
      "maxLength": 4000000
    },
    "userName": {
      "type": "string",
      "maxLength": 4000000
    },
    "action": {
      "type": "string",
      "maxLength": 4000000
    },
    "details": {
      "type": "string",
      "maxLength": 4000000
    }
  },
  "required": [
    "projectId",
    "userId",
    "action"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "data.ownerUserId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.ownerUserId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.ownerUserId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}