{
  "name": "ContactRequest",
  "type": "object",
  "properties": {
    "subject": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "read",
        "resolved"
      ],
      "default": "new"
    }
  },
  "required": [
    "subject",
    "email",
    "body"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}