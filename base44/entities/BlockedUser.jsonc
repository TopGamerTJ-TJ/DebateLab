{
  "name": "BlockedUser",
  "type": "object",
  "properties": {
    "blockerId": {
      "type": "string"
    },
    "blockedUserId": {
      "type": "string"
    },
    "blockedUserName": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "blockerId",
    "blockedUserId"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.blockerId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.blockerId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.blockerId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}