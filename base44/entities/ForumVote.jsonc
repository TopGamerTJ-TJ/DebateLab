{
  "name": "ForumVote",
  "type": "object",
  "properties": {
    "itemId": {
      "type": "string",
      "maxLength": 4000000
    },
    "itemType": {
      "type": "string",
      "enum": [
        "post",
        "comment"
      ],
      "maxLength": 4000000
    },
    "voteValue": {
      "type": "number",
      "enum": [
        1,
        -1
      ]
    }
  },
  "required": [
    "itemId",
    "itemType",
    "voteValue"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}