{
  "name": "FlashcardSet",
  "type": "object",
  "properties": {
    "ownerUserId": {
      "type": "string",
      "maxLength": 4000000
    },
    "title": {
      "type": "string",
      "maxLength": 4000000
    },
    "projectId": {
      "type": "string",
      "maxLength": 4000000
    },
    "sourceSummary": {
      "type": "string",
      "maxLength": 4000000
    },
    "keyPoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cue": {
            "type": "string",
            "maxLength": 4000000
          },
          "detail": {
            "type": "string",
            "maxLength": 4000000
          }
        }
      }
    },
    "acronym": {
      "type": "string",
      "maxLength": 4000000
    },
    "acronymMeaning": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4000000
      }
    },
    "flashcards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "front": {
            "type": "string",
            "maxLength": 4000000
          },
          "back": {
            "type": "string",
            "maxLength": 4000000
          }
        }
      }
    },
    "tips": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4000000
      }
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.ownerUserId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.ownerUserId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.ownerUserId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}