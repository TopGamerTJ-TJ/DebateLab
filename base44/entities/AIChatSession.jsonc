{
  "name": "AIChatSession",
  "type": "object",
  "properties": {
    "ownerUserId": {
      "type": "string",
      "maxLength": 4000000
    },
    "auditId": {
      "type": "number"
    },
    "title": {
      "type": "string",
      "maxLength": 4000000
    },
    "projectId": {
      "type": "string",
      "maxLength": 4000000
    },
    "feature": {
      "type": "string",
      "enum": [
        "editor",
        "coach",
        "research"
      ],
      "maxLength": 4000000
    }
  },
  "required": [
    "title",
    "feature"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.ownerUserId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.ownerUserId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.ownerUserId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}