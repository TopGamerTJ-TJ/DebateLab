{
  "name": "CongressBill",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 4000000
    },
    "type": {
      "type": "string",
      "enum": [
        "bill",
        "resolution",
        "amendment",
        "speech",
        "committee_prep"
      ],
      "maxLength": 4000000
    },
    "sponsor": {
      "type": "string",
      "maxLength": 4000000
    },
    "topic": {
      "type": "string",
      "maxLength": 4000000
    },
    "content": {
      "type": "string",
      "maxLength": 4000000
    },
    "policyArea": {
      "type": "string",
      "maxLength": 4000000
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4000000
      }
    },
    "isFavorite": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "passed",
        "failed"
      ],
      "maxLength": 4000000
    },
    "notes": {
      "type": "string",
      "maxLength": 4000000
    }
  },
  "required": [
    "title",
    "type"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}