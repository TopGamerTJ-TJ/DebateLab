{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "ownerUserId": {
      "type": "string"
    },
    "auditId": {
      "type": "number"
    },
    "displayName": {
      "type": "string"
    },
    "school": {
      "type": "string"
    },
    "gradeLevel": {
      "type": "string"
    },
    "preferredFormat": {
      "type": "string"
    },
    "skillLevel": {
      "type": "string",
      "enum": [
        "new",
        "beginner",
        "intermediate",
        "advanced",
        "expert"
      ]
    },
    "bio": {
      "type": "string"
    },
    "totalPracticeSessions": {
      "type": "number"
    },
    "totalContentions": {
      "type": "number"
    },
    "totalTournaments": {
      "type": "number"
    },
    "wins": {
      "type": "number"
    },
    "losses": {
      "type": "number"
    },
    "learnTabEnabled": {
      "type": "boolean",
      "default": false
    },
    "learningPathType": {
      "type": "string",
      "enum": [
        "debate",
        "model_un",
        "model_congress"
      ]
    },
    "learningPathFormat": {
      "type": "string",
      "enum": [
        "public_forum",
        "parliamentary"
      ]
    },
    "defaultAiMode": {
      "type": "string",
      "enum": [
        "full",
        "dampened"
      ],
      "default": "full"
    },
    "notificationsEnabled": {
      "type": "boolean",
      "default": true
    },
    "themeMode": {
      "type": "string",
      "enum": [
        "light",
        "dark"
      ]
    },
    "customColors": {
      "type": "object"
    }
  },
  "required": [],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.ownerUserId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.ownerUserId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.ownerUserId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}